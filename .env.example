# Veritabanı — SQLite (lokal geliştirme)
DATABASE_URL="file:./dev.db"

# Admin oturum imzalama anahtarı (üretimde mutlaka değiştirin)
AUTH_SECRET="buraya-rastgele-32-karakterlik-bir-anahtar-yazin"

# İlk admin kullanıcısı (seed betiği bunu kullanır)
ADMIN_EMAIL="emirhan@remaxeksen.com"
ADMIN_PASSWORD="guclu-bir-sifre-belirleyin"

# Site adresi (SEO / OG etiketleri için)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==========================================================================
# Talep bildirimleri
#
# Aşağıdakiler BOŞ BIRAKILABİLİR. Tanımlı olmayan kanal sessizce atlanır,
# form çalışmaya devam eder ve talep her hâlükârda /admin/talepler'e düşer.
# ==========================================================================

# Bildirimlerin gideceği adres ve numara
LEAD_NOTIFY_EMAIL="emirhan@remaxeksen.com"
LEAD_NOTIFY_WHATSAPP="0532 000 00 00"

# --- E-posta (SMTP) -------------------------------------------------------
# Gmail için: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 ve SMTP_PASSWORD olarak
# hesap şifresi DEĞİL, Google hesabından üretilen "uygulama şifresi" girilmeli.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Gönderen adresi; boşsa SMTP_USER kullanılır
SMTP_FROM="Emirhan Şimşek Web <emirhan@remaxeksen.com>"

# --- WhatsApp (Meta Cloud API) --------------------------------------------
# Meta for Developers > uygulamanız > WhatsApp > API Setup ekranından alınır.
# DİKKAT: gönderici numara Cloud API'ye kayıtlı olmak zorunda ve o numara normal
# WhatsApp uygulamasında kullanılamaz — Emirhan'ın kendi hattından farklı bir
# numara gerekiyor. Bildirim o numaradan Emirhan'ın hattına düşer.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Meta'nın 24 saat kuralı gereği üretimde ONAYLANMIŞ bir şablon şart.
# Boş bırakılırsa düz metin denenir — yalnızca alıcı son 24 saat içinde
# işletme numarasına yazdıysa çalışır, kurulumu test etmek için pratiktir.
#
# Meta Business Manager'da oluşturulacak şablon (kategori: UTILITY, dil: tr):
#
#   Yeni {{1}} talebi.
#
#   Ad: {{2}}
#   Telefon: {{3}}
#   Detay: {{4}}
#
WHATSAPP_TEMPLATE_NAME=""
WHATSAPP_TEMPLATE_LANG="tr"
# Graph API sürümü — Meta eski sürümleri emekliye ayırdığında güncelleyin
WHATSAPP_GRAPH_VERSION="v23.0"
